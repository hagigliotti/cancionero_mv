      "playback": "innario_it/audio/playbacks/{num}.mp3"
    },
    "melodias_de_victoria": {
      "_comentario": "Hoy los mp3 están sueltos en audio/ (sin carpeta vocal/): la 2da ruta los toma igual hasta que se muevan a audio/vocal/",
      "vocal":    ["otros_himnarios/melodias_de_victoria/audio/vocal/{num}.mp3", "otros_himnarios/melodias_de_victoria/audio/{num}.mp3"],
      "playback": "otros_himnarios/melodias_de_victoria/audio/playbacks/{num}.mp3"
    },

