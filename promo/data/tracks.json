[{"id":"amigos_de_esperanza","t":"Amigos de esperanza","a":"Santiago Sáenz","d":190,"c":"#505049","l":["","Hoy te quiero presentar","Un nombre singular","Amigo de verdad","En sus fuerzas hay poder","Lo debes conocer","Su fuerza es sin igual","","Puente","Vivo a su lado la experiencia de su paz","Y creyendo en sus promesas crezco cada día más","","Coro","Yo soy amigo, amigo de Jesús","De su palabra, de su amor y de su luz","Yo soy amigo, amigo de Jesús","De su esperanza, de su bendita cruz","Soy amigo de esperanza","Hoy te quiero presentar al buen Jesús","","Puente","Yo soy amigo, amigo de Jesús","De su palabra, de su amor y de su luz","Soy amigo de esperanza","Es por eso mi alabanza","Cada día quiero ser como Jesús","","","Hoy te quiero preguntar","Lo quieres conocer","Tu vida va a cambiar","Ven y prueba su poder","Sus fuerzas te dará","Victorias ganarás","","Puente","Vive a su lado la experiencia de su paz","Y creyendo en sus promesas crezco cada día más","","Coro"],"cv":"amigos_de_esperanza"},{"id":"sinfonia_de_unidad","t":"Sinfonía de unidad","a":"Anónimo","d":229,"c":"#b2b3a6","l":["","Quiero que alguien me explique","qué es la unidad,","quiero servir a los demás","pero Él desea que lo hagamos juntos.","","Puente","Podemos cantar diferentes notas","pero cantamos la misma canción,","una canción de amor.","","Coro","Vamos todos juntos,","vamos a cantar","diferentes notas,","la misma canción.","Esta es la sinfonía,","sinfonía de unidad.","Es Jesús quien la compuso.","","","Gracias, ahora entendí","qué es la unidad.","Quiero cantar con los demás","esa sinfonía que Jesús compuso.","","Puente","Podemos cantar diferentes notas","pero cantamos la misma canción,","una canción de amor.","","Coro","Vamos todos juntos,","vamos a cantar","diferentes notas,","la misma canción.","Esta es la sinfonía,","sinfonía de unidad.","Es Jesús quien la compuso.",""],"cv":"mis_cantos"},{"id":"necesario","t":"Necesario","a":"Denis Boidi","d":185,"c":"#b2b3a6","l":["","Necesario como el aire,","necesario como el sol,","tú eres para mí.","Como agua en el desierto,","un amigo en el dolor,","Te necesito Jesús.","","Coro","Sólo tú llenas mi ser,","sólo tú me das poder,","la energía para vivir.","","Modula","","Necesario como el aire,","necesario como el sol,","tú eres para mí.","Como agua en el desierto,","un amigo en el dolor,","Te necesito Jesús.","","Coro","Sólo tú llenas mi ser,","sólo tú me das poder,","la energía para vivir.","Te necesito, Jesús."],"cv":"mis_cantos"},{"id":"somos_su_voz","t":"Somos su voz","a":"Jeff Wood","d":155,"c":"#b2b3a6","l":["","Somos su voz,","daremos su mensaje;","somos sus pies,","iremos por doquier.","","Coro","Somos su amor conquistando el mundo.","En la oscuridad brillará su luz.","","","Sus manos dan","alivio en la aflicción,","sus ojos ven","necesidad de paz.","","Coro","Somos su amor conquistando el mundo.","En la oscuridad brillará su luz.","","Repite","Somos su amor conquistando el mundo.","En la oscuridad brillará su luz."],"cv":"mis_cantos"},{"id":"el_amor_de_cristo","t":"El amor de Cristo","a":"Anónimo","d":123,"c":"#b2b3a6","l":["","El amor de Cristo es dulce y grande,","el amor de Cristo es dulce y grande,","el amor de Cristo es dulce y grande,","oh, oh, grande es su amor.","","Coro","Alto, así de alto es el amor de Cristo.","Hondo, así de hondo es el amor de Cristo.","Pronto vendrá a buscarme,","oh, oh, grande es su amor."],"cv":"mis_cantos"},{"id":"tres_palabritas_solas","t":"Tres palabritas solas","a":"Anónimo","d":101,"c":"#b2b3a6","l":["","Tres palabritas solas","yo aprendí muy bien:","«Dios es amor»","yalalá lalá lá lá."],"cv":"mis_cantos"}]